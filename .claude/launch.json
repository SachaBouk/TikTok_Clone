{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "api-worker",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "turbo",
        "run",
        "dev",
        "--filter=api",
        "--filter=worker"
      ],
      "port": 3000
    }
  ]
}
