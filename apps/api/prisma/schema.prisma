// Modèle de données (ADR-006), périmètre MVP (ADR-016).
// Conventions : modèles et champs en camelCase côté code, tables et colonnes en snake_case en base.
// Les clés primaires suivent le nommage des ADR (`user_id`, `video_id`, `conversation_id`…).
// Identifiants UUID v7 : ordonnés dans le temps, donc adaptés à la pagination.
//
// Contraintes CHECK ajoutées à la main dans les migrations (Prisma ne sait pas les exprimer) :
// pas d'auto-follow, solde de portefeuille ≥ 0, montant de cadeau > 0 (migration initiale) ;
// notification cohérente avec son type et jamais adressée à son auteur (migration notifications).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
  // Index uniques partiels (`where`) des notifications.
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ─── Compte (ADR-010, ADR-016) ───────────────────────────────────────────────

// Rôle du compte (ADR-004) : `admin` ouvre les routes /admin du backoffice. Attribué uniquement par le
// script `pnpm admin:grant`, jamais par une route de l'API.
enum UserRole {
  user
  admin

  @@map("user_role")
}

model User {
  id             String   @id @default(uuid(7)) @map("user_id") @db.Uuid
  // Nul pour un compte Apple dont l'email n'a pas été partagé.
  email          String?  @unique
  // Nul pour un compte créé uniquement via Sign in with Apple.
  passwordHash   String?  @map("password_hash")
  // Identifiant stable renvoyé par Sign in with Apple (`sub`).
  appleSub       String?  @unique @map("apple_sub")
  // Pseudo (@handle).
  username       String   @unique
  // Nom affiché.
  displayName    String   @map("display_name")
  avatarUrl      String?  @map("avatar_url")
  bio            String?
  role           UserRole @default(user)
  // Suspension par un administrateur (ADR-037), propriété du module auth : connexion refusée, contenus masqués.
  // Les trois colonnes sont remplies ou vides ensemble (CHECK écrit à la main), sauf `suspended_by`, mis à nul si
  // l'administrateur supprime son compte.
  suspendedAt      DateTime? @map("suspended_at")
  // Motif interne, visible des seuls administrateurs.
  suspensionReason String?   @map("suspension_reason")
  suspendedById    String?   @map("suspended_by") @db.Uuid
  // Compteurs dénormalisés, maintenus par les services applicatifs.
  followersCount Int      @default(0) @map("followers_count")
  followingCount Int      @default(0) @map("following_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  videos                   Video[]
  likes                    Like[]
  favorites                Favorite[]
  reposts                  Repost[]
  comments                 Comment[]
  following                Follow[]                  @relation("Follower")
  followers                Follow[]                  @relation("Following")
  viewHistory              ViewHistory[]
  conversationParticipants ConversationParticipant[]
  messagesSent             Message[]
  notificationsReceived    Notification[]            @relation("NotificationRecipient")
  notificationsTriggered   Notification[]            @relation("NotificationActor")
  wallet                   Wallet?
  giftsSent                GiftSent[]                @relation("GiftSender")
  giftsReceived            GiftSent[]                @relation("GiftRecipient")
  refreshTokens            RefreshToken[]
  blocksMade               Block[]                   @relation("Blocker")
  blocksReceived           Block[]                   @relation("Blocked")
  conversationRequests     Conversation[]            @relation("ConversationRequestSender")
  pushDevices              PushDevice[]
  suspendedBy              User?                     @relation("SuspendedBy", fields: [suspendedById], references: [id], onDelete: SetNull)
  suspensionsMade          User[]                    @relation("SuspendedBy")
  reportsMade              Report[]                  @relation("Reporter")
  reportsReceived          Report[]                  @relation("ReportTargetUser")
  reportsResolved          Report[]                  @relation("ReportResolver")
  moderationActionsMade    ModerationAction[]        @relation("ModerationAdmin")
  moderationActionsAbout   ModerationAction[]        @relation("ModerationTargetUser")
  walletTransactions       WalletTransaction[]

  // Comptes suspendus : relus en entier au démarrage de l'API (registre Redis), comptés par le tableau de bord.
  @@index([suspendedAt], map: "users_suspended_idx", where: raw("suspended_at IS NOT NULL"))
  @@map("users")
}

// Refresh tokens (ADR-010) : opaques, stockés hachés (SHA-256), rotatifs.
// Chaque rotation crée un nouveau token dans la même famille et révoque l'ancien.
// Présenter un token déjà révoqué (réutilisation, donc vol probable) révoque toute la famille.
model RefreshToken {
  id        String    @id @default(uuid(7)) @map("refresh_token_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  // Une famille = une session (un appareil connecté).
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

// ─── Vidéos (ADR-006, ADR-007, ADR-008) ──────────────────────────────────────

enum VideoStatus {
  uploading
  processing
  ready
  failed

  @@map("video_status")
}

model Video {
  id             String      @id @default(uuid(7)) @map("video_id") @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  description    String?
  // Clé de l'objet brut dans le bucket des uploads (ADR-007).
  rawKey         String      @map("raw_key")
  // Identifiant de l'upload multipart en cours ; nul une fois l'upload terminé (ADR-007).
  uploadId       String?     @map("upload_id")
  // Taille déclarée du fichier brut, en octets : l'objet assemblé doit la respecter exactement.
  rawSize        Int         @map("raw_size")
  // URL du manifeste HLS, renseignée quand le transcodage est terminé (ADR-008).
  hlsUrl         String?     @map("hls_url")
  thumbnailUrl   String?     @map("thumbnail_url")
  status         VideoStatus @default(uploading)
  // Compteurs dénormalisés, maintenus par les services applicatifs.
  viewsCount     Int         @default(0) @map("views_count")
  likesCount     Int         @default(0) @map("likes_count")
  commentsCount  Int         @default(0) @map("comments_count")
  favoritesCount Int         @default(0) @map("favorites_count")
  repostsCount   Int         @default(0) @map("reposts_count")
  sharesCount    Int         @default(0) @map("shares_count")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes         Like[]
  favorites     Favorite[]
  reposts       Repost[]
  comments      Comment[]
  viewHistory   ViewHistory[]
  notifications Notification[]

  @@index([userId, createdAt])
  // Le feed ne sert que les vidéos `ready`.
  @@index([status])
  @@map("videos")
}

// ─── Interactions (ADR-006, ADR-016) ─────────────────────────────────────────
// Clés composites : double like / favori / republication / follow impossibles par construction.

model Like {
  userId    String   @map("user_id") @db.Uuid
  videoId   String   @map("video_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([userId, videoId])
  @@index([videoId])
  // Grille des vidéos likées, du like le plus récent au plus ancien.
  @@index([userId, createdAt])
  @@map("likes")
}

model Favorite {
  userId    String   @map("user_id") @db.Uuid
  videoId   String   @map("video_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([userId, videoId])
  @@index([videoId])
  // Grille du profil, de l'action la plus récente à la plus ancienne.
  @@index([userId, createdAt])
  @@map("favorites")
}

model Repost {
  userId    String   @map("user_id") @db.Uuid
  videoId   String   @map("video_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([userId, videoId])
  @@index([videoId])
  // Grille du profil, de l'action la plus récente à la plus ancienne.
  @@index([userId, createdAt])
  @@map("reposts")
}

model Follow {
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  // Listes d'abonnés et d'abonnements, du follow le plus récent au plus ancien.
  @@index([followingId, createdAt])
  @@index([followerId, createdAt])
  @@map("follows")
}

model Comment {
  id        String   @id @default(uuid(7)) @map("comment_id") @db.Uuid
  videoId   String   @map("video_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  video         Video          @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([videoId, createdAt])
  // Historique des commentaires du centre d'activités.
  @@index([userId, createdAt])
  @@map("comments")
}

// Une ligne par vidéo vue ; `viewed_at` est mis à jour à chaque nouveau visionnage.
model ViewHistory {
  userId   String   @map("user_id") @db.Uuid
  videoId  String   @map("video_id") @db.Uuid
  viewedAt DateTime @default(now()) @map("viewed_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([userId, videoId])
  @@index([userId, viewedAt])
  @@map("view_history")
}

// ─── Messagerie directe (ADR-006, ADR-011) ───────────────────────────────────

model Conversation {
  id              String    @id @default(uuid(7)) @map("conversation_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  // Demande de message (ADR-016) : premier message envoyé hors abonnés mutuels, par ce compte.
  requestSenderId String?   @map("request_sender_id") @db.Uuid
  // Conversation ouverte durablement (demande acceptée, réponse, ou premier message entre abonnés mutuels).
  acceptedAt      DateTime? @map("accepted_at")
  // Demande refusée par son destinataire : elle ne lui est plus montrée, l'expéditeur n'en sait rien.
  declinedAt      DateTime? @map("declined_at")

  requestSender User?                     @relation("ConversationRequestSender", fields: [requestSenderId], references: [id], onDelete: SetNull)
  participants  ConversationParticipant[]
  messages      Message[]

  @@map("conversations")
}

model ConversationParticipant {
  conversationId       String  @map("conversation_id") @db.Uuid
  userId               String  @map("user_id") @db.Uuid
  // Dernier message lu (non-lus, badge, « Vu »). Simple repère ordonné (UUID v7), sans clé étrangère :
  // si ce message disparaît (compte de son auteur supprimé), le repère reste valable.
  lastReadMessageId    String? @map("last_read_message_id") @db.Uuid
  // Conversation supprimée pour ce participant : les messages jusqu'à ce repère lui sont masqués.
  // Elle réapparaît au message suivant. Même principe de repère ordonné, sans clé étrangère.
  clearedUpToMessageId String? @map("cleared_up_to_message_id") @db.Uuid

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  // Retrouver les conversations d'un utilisateur.
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String   @id @default(uuid(7)) @map("message_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  senderId       String   @map("sender_id") @db.Uuid
  // Vide si le message ne fait que partager une vidéo (contrainte CHECK : texte ou vidéo).
  content        String
  // Vidéo partagée. Sans clé étrangère : une vidéo supprimée reste signalée « indisponible » dans le message.
  sharedVideoId  String?  @map("shared_video_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  // Pagination et dernier message d'une conversation, par identifiant (UUID v7, ordonné dans le temps).
  @@index([conversationId, id])
  @@map("messages")
}

// ─── Activité / notifications (ADR-016) ──────────────────────────────────────

enum NotificationType {
  like
  comment
  follow
  repost
  // Modération (ADR-038), sans auteur : décision sur un signalement, contenu retiré par un administrateur.
  reportResolved @map("report_resolved")
  contentRemoved @map("content_removed")

  @@map("notification_type")
}

model Notification {
  id          String           @id @default(uuid(7)) @map("notification_id") @db.Uuid
  // Destinataire.
  userId      String           @map("user_id") @db.Uuid
  // Auteur de l'action ; nul pour une notification de modération (CHECK écrit à la main).
  actorId     String?          @map("actor_id") @db.Uuid
  type        NotificationType
  // Renseignés selon le type (nuls pour un follow).
  videoId     String?          @map("video_id") @db.Uuid
  commentId   String?          @map("comment_id") @db.Uuid
  // Copie du commentaire (type comment) : le module notifications ne lit pas la table des commentaires
  // (ADR-003). Pas de décalage possible : un commentaire ne se modifie pas, et sa suppression supprime
  // la notification (cascade).
  commentText String?          @map("comment_text")
  // Modération (ADR-038) : contenu concerné, motif (contenu retiré), décision (signalement examiné), texte copié.
  moderationTargetType ReportTargetType? @map("moderation_target_type")
  moderationReason     ReportReason?     @map("moderation_reason")
  moderationOutcome    ReportResolution? @map("moderation_outcome")
  moderationExcerpt    String?           @map("moderation_excerpt")
  readAt      DateTime?        @map("read_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  user    User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor   User?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  video   Video?   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  // Au plus une notification par like, republication et follow : retirée au retrait de l'interaction,
  // recréée si elle revient. `createMany({ skipDuplicates })` s'appuie sur ces index.
  // Un index par type : PostgreSQL réécrit `type IN (…)`, ce que Prisma verrait comme une dérive.
  @@unique([actorId, videoId], map: "notifications_like_key", where: raw("type = 'like'"))
  @@unique([actorId, videoId], map: "notifications_repost_key", where: raw("type = 'repost'"))
  @@unique([actorId, userId], map: "notifications_follow_key", where: raw("type = 'follow'"))
  @@index([userId, createdAt])
  @@map("notifications")
}

// ─── Jetons (ADR-009) ────────────────────────────────────────────────────────
// PostgreSQL est la source de vérité du solde ; RevenueCat ne fait que valider les achats.

model Wallet {
  // Un portefeuille par utilisateur.
  userId    String   @id @map("user_id") @db.Uuid
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

// Dépense de jetons (cadeaux) : reportée après le MVP (ADR-016), table prévue par l'ADR-006.
// Émetteur et destinataire passent à NULL si un compte est supprimé : l'historique des transferts est conservé.
// Journal des mouvements du solde (ADR-009) : une ligne par événement RevenueCat appliqué. L'identifiant de
// l'événement est unique : un webhook rejoué ne crédite pas deux fois. À la suppression du compte, les lignes
// restent, anonymisées (comme gifts_sent), pour le rapprochement avec RevenueCat.
enum WalletTransactionKind {
  purchase
  refund
  adjustment

  @@map("wallet_transaction_kind")
}

model WalletTransaction {
  id                 String                @id @default(uuid(7)) @map("wallet_transaction_id") @db.Uuid
  // Nul : compte supprimé depuis, ou acheteur inconnu de l'API (à rapprocher à la main, via appUserId).
  userId             String?               @map("user_id") @db.Uuid
  kind               WalletTransactionKind
  // Mouvement annoncé par RevenueCat (signé, jamais nul : CHECK de la migration).
  amount             Int
  // Mouvement réellement appliqué : un retrait ne fait pas passer le solde sous 0 ; 0 pour un acheteur inconnu.
  appliedAmount      Int                   @map("applied_amount")
  // Solde après le mouvement ; nul pour un acheteur inconnu (aucun portefeuille touché).
  balanceAfter       Int?                  @map("balance_after")
  revenuecatEventId  String                @unique @map("revenuecat_event_id")
  // Identifiant du client chez RevenueCat (UUID du compte, ou identifiant anonyme).
  appUserId          String                @map("app_user_id")
  productId          String?               @map("product_id")
  storeTransactionId String?               @map("store_transaction_id")
  store              String?
  // SANDBOX ou PRODUCTION.
  environment        String
  // Date de l'événement chez RevenueCat.
  occurredAt         DateTime              @map("occurred_at")
  createdAt          DateTime              @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Historique d'un compte, du plus récent au plus ancien (identifiant UUID v7).
  @@index([userId, id])
  @@map("wallet_transactions")
}

model GiftSent {
  id          String   @id @default(uuid(7)) @map("gift_id") @db.Uuid
  senderId    String?  @map("sender_id") @db.Uuid
  recipientId String?  @map("recipient_id") @db.Uuid
  amount      Int
  createdAt   DateTime @default(now()) @map("created_at")

  sender    User? @relation("GiftSender", fields: [senderId], references: [id], onDelete: SetNull)
  recipient User? @relation("GiftRecipient", fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([senderId, createdAt])
  @@index([recipientId, createdAt])
  @@map("gifts_sent")
}

// ─── Blocage (ADR-016) ───────────────────────────────────────────────────────
// Dans les deux sens : ni messages, ni follows, ni likes, commentaires ou republications entre les deux comptes.

model Block {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

// ─── Notifications push (APNs) ───────────────────────────────────────────────

enum PushEnvironment {
  sandbox
  production

  @@map("push_environment")
}

model PushDevice {
  // Token APNs de l'appareil : unique, il passe au dernier compte connecté sur l'appareil.
  token       String          @id
  userId      String          @map("user_id") @db.Uuid
  // Build de développement (sandbox) ou App Store / TestFlight (production) : serveurs APNs différents.
  environment PushEnvironment
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_devices")
}

// ─── Signalements (ADR-038) ──────────────────────────────────────────────────

enum ReportTargetType {
  video
  comment
  account
  message

  @@map("report_target_type")
}

enum ReportReason {
  spam
  harassment
  hate
  violence
  sexual
  impersonation
  other

  @@map("report_reason")
}

enum ReportResolution {
  contentRemoved   @map("content_removed")
  accountSuspended @map("account_suspended")
  dismissed
  // Clos automatiquement (triggers) : contenu supprimé par son auteur, compte supprimé.
  contentDeleted   @map("content_deleted")
  accountDeleted   @map("account_deleted")

  @@map("report_resolution")
}

model Report {
  id           String           @id @default(uuid(7)) @map("report_id") @db.Uuid
  // Nul si la personne qui a signalé a supprimé son compte depuis (le signalement reste dans l'historique).
  reporterId   String?          @map("reporter_id") @db.Uuid
  targetType   ReportTargetType @map("target_type")
  // Vidéo, commentaire ou compte signalé. Pas de clé étrangère : le signalement survit à la suppression du contenu.
  targetId     String           @map("target_id") @db.Uuid
  // Compte visé (auteur du contenu, ou le compte lui-même) ; nul s'il a été supprimé depuis (signalement gardé, anonymisé).
  targetUserId   String?          @map("target_user_id") @db.Uuid
  // Pseudo du compte visé au moment du signalement, pour l'historique.
  targetUsername String           @map("target_username")
  reason       ReportReason
  // Précision facultative de la personne qui signale (500 caractères au plus).
  details      String?
  // Copie du texte signalé au moment du signalement (commentaire, description de la vidéo).
  excerpt      String?
  createdAt    DateTime         @default(now()) @map("created_at")
  // Décision d'un administrateur : nulle tant que le signalement est ouvert (CHECK écrit à la main).
  resolution   ReportResolution?
  resolvedAt   DateTime?        @map("resolved_at")
  resolvedById String?          @map("resolved_by") @db.Uuid

  reporter   User? @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  targetUser User? @relation("ReportTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  resolvedBy User? @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  // Un seul signalement ouvert par personne et par cible.
  @@unique([reporterId, targetType, targetId], map: "reports_open_key", where: raw("resolution IS NULL"))
  @@index([targetType, targetId])
  @@index([targetUserId])
  // File de modération : signalements ouverts, du plus récent au plus ancien.
  @@index([id], map: "reports_open_idx", where: raw("resolution IS NULL"))
  @@map("reports")
}

// ─── Journal de modération (ADR-038) ─────────────────────────────────────────

enum ModerationActionType {
  videoRemoved     @map("video_removed")
  commentRemoved   @map("comment_removed")
  messageRemoved   @map("message_removed")
  accountSuspended @map("account_suspended")
  suspensionLifted @map("suspension_lifted")
  reportsDismissed @map("reports_dismissed")

  @@map("moderation_action_type")
}

// Une action d'un administrateur. Les pseudos et le texte sont copiés : le journal survit à la suppression des comptes
// et des contenus.
model ModerationAction {
  id             String               @id @default(uuid(7)) @map("action_id") @db.Uuid
  adminId        String?              @map("admin_id") @db.Uuid
  adminUsername  String               @map("admin_username")
  action         ModerationActionType
  targetType     ReportTargetType     @map("target_type")
  targetId       String               @map("target_id") @db.Uuid
  targetUserId   String?              @map("target_user_id") @db.Uuid
  targetUsername String?              @map("target_username")
  // Motif de la liste (contenu retiré), ou texte libre (suspension).
  reason         ReportReason?
  note           String?
  excerpt        String?
  // Signalements ouverts clos par cette action.
  reportsClosed  Int                  @default(0) @map("reports_closed")
  createdAt      DateTime             @default(now()) @map("created_at")

  admin      User? @relation("ModerationAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  targetUser User? @relation("ModerationTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([targetUserId, id])
  @@map("moderation_actions")
}
