{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "prisma generate && tsc-watch -p tsconfig.build.json --onSuccess \"node --env-file-if-exists=../../.env dist/main.js\"",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit && tsc -p scripts/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi:export": "pnpm run build && node dist/openapi/export.js",
    "openapi:check": "pnpm run build && node dist/openapi/export.js --check",
    "seed": "tsx --env-file-if-exists=../../.env scripts/seed.ts",
    "admin:grant": "tsx --env-file-if-exists=../../.env scripts/admin-role.ts grant",
    "admin:revoke": "tsx --env-file-if-exists=../../.env scripts/admin-role.ts revoke",
    "admin:list": "tsx --env-file-if-exists=../../.env scripts/admin-role.ts list",
    "clean": "rm -rf dist .turbo src/generated",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@aws-sdk/s3-request-presigner": "^3.1139.0",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/platform-ws": "^12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/websockets": "^12.1.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@repo/shared": "workspace:*",
    "bullmq": "^6.3.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "livekit-server-sdk": "^2.19.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/ws": "^8.18.1",
    "prisma": "7.10.0",
    "tsc-watch": "^7.2.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.0.1"
  }
}
