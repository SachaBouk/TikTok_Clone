# Copier en `.env` : `cp .env.example .env`
# Valeurs de développement local uniquement (docker-compose.yml).

# --- PostgreSQL (ADR-006)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432
DATABASE_URL=postgresql://app:app@localhost:5432/app

# --- Redis (ADR-014)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- MinIO / stockage compatible S3 (ADR-015)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
# Hôte des URLs signées données à l'app (défaut : S3_ENDPOINT). Pour un iPhone physique,
# mettre l'IP du Mac sur le réseau local, ex. http://192.168.1.20:9000.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# MinIO exige l'adressage par chemin (http://host/bucket/clé).
S3_FORCE_PATH_STYLE=true
S3_BUCKET_RAW=videos-raw
S3_BUCKET_HLS=videos-hls
# Base publique des fichiers HLS et des miniatures (ADR-008) : le CDN en production,
# le bucket HLS de MinIO (lecture anonyme) en local. Sur iPhone physique : l'IP du Mac.
HLS_PUBLIC_BASE_URL=http://localhost:9000/videos-hls
# Photos de profil : bucket en lecture anonyme, et sa base publique (le CDN en production).
# Sur iPhone physique : l'IP du Mac.
S3_BUCKET_AVATARS=avatars
AVATARS_PUBLIC_BASE_URL=http://localhost:9000/avatars

# --- Authentification (ADR-010)
# Clé de signature des access tokens (HS256), 32 caractères minimum.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=a-remplacer-par-une-valeur-aleatoire-de-32-caracteres-minimum
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Bundle ID de l'app iOS : audience attendue dans les identity tokens Sign in with Apple.
APPLE_BUNDLE_ID=com.sachabouk.tiktokclone

# Proxys devant l'API (facultatif) : l'adresse IP du client sert aux limites de débit (connexion, partages).
# Absent : pas de proxy. `1` derrière un répartiteur de charge ; ou une liste d'adresses de confiance
# (`loopback, 10.0.0.0/8`). Jamais `true` sans proxy : un client pourrait choisir son IP (X-Forwarded-For).
# TRUST_PROXY=1

# --- Notifications push APNs (facultatif). Sans ces variables, les notifications sont seulement journalisées.
# Clé d'authentification APNs (.p8) créée sur developer.apple.com (Certificates, Identifiers & Profiles > Keys).
# APNS_KEY_ID=ABC123DEFG
# APNS_TEAM_ID=TEAM123456
# Contenu de la clé (retours à la ligne en \n), ou chemin du fichier .p8 :
# APNS_KEY_FILE=/chemin/vers/AuthKey_ABC123DEFG.p8
# Par défaut APPLE_BUNDLE_ID :
# APNS_TOPIC=com.sachabouk.tiktokclone

# --- Jetons et RevenueCat (ADR-009), facultatif. Sans secret, le webhook répond 503 et rien n'est crédité.
# Valeur exacte de l'en-tête Authorization du webhook, configurée dans RevenueCat (Integrations > Webhooks),
# 16 caractères au moins. URL du webhook : https://<api>/webhooks/revenuecat.
# REVENUECAT_WEBHOOK_AUTHORIZATION=Bearer une-valeur-aleatoire-longue
# Code de la monnaie virtuelle des jetons dans RevenueCat (Product catalog > Virtual currencies).
# REVENUECAT_CURRENCY_CODE=TKN
# true : les achats de test (SANDBOX : Xcode, TestFlight, Test Store) ne créditent rien.
# REVENUECAT_REJECT_SANDBOX=false

# --- Backoffice (ADR-004), facultatif
# API appelée par le backoffice, côté serveur uniquement (défaut : http://localhost:3000).
# API_URL=http://localhost:3000
# Projet PostHog, pour les liens du tableau de bord (ex. https://eu.posthog.com/project/12345).
# POSTHOG_PROJECT_URL=

# --- Worker de transcodage (ADR-008), valeurs par défaut
# TRANSCODE_CONCURRENCY=1
# TRANSCODE_X264_PRESET=veryfast
# TRANSCODE_TIMEOUT_MINUTES=30
