{
  "name": "monorepo",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "openapi:export": "pnpm --filter api openapi:export",
    "openapi:check": "pnpm --filter api openapi:check",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "infra:up": "docker compose up -d --wait postgres redis minio && docker compose run --rm minio-init",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:reset": "docker compose down -v && pnpm infra:up",
    "apps:up": "pnpm infra:up && docker compose --profile apps up -d --build --wait api worker backoffice",
    "apps:down": "docker compose --profile apps rm -sf api worker backoffice migrate",
    "apps:logs": "docker compose --profile apps logs -f api worker backoffice",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:deploy": "pnpm --filter api db:deploy",
    "db:reset": "pnpm --filter api db:reset",
    "db:studio": "pnpm --filter api db:studio",
    "seed": "pnpm --filter api seed --",
    "admin:grant": "pnpm --filter api admin:grant --",
    "admin:revoke": "pnpm --filter api admin:revoke --",
    "admin:list": "pnpm --filter api admin:list"
  },
  "devDependencies": {
    "turbo": "^2.11.3",
    "typescript": "~6.0.2"
  }
}
